  "info": {
    "_postman_id": "ff43b7e9-0e05-4480-bdd2-d447979f6d42",
    "name": "LiquidM Management Ads Campaigns API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Campaign management API for the LiquidM demand-side platform. The API is organised around campaigns, budgets and ads: a campaign carries currency, unit type, pacing timezone and IAB category; one or more budgets carry the pacing and spend caps; ads bind creative, supply, targeting and setting sections to a campaign. LiquidM publishes an MIT-licensed first-party JavaScript client (lqmapi.js) that exercises this surface, including a dry-run mode that emulates create responses without writing.\n\nContact Support:\n Name: LiquidM open source\n Email: opensource@liquidm.com",
      "type": "text/plain"
    }
  }
