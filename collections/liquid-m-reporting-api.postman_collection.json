{
  "item": [
    {
      "id": "29223bb1-2c66-407c-96e9-79c6292bd280",
      "name": "Reporting",
      "description": {
        "content": "Visual report queries across dimensions and metrics.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "9ae95bc3-3379-4cd7-ab66-6d2a18ef8323",
          "name": "Run a visual report",
          "request": {
            "name": "Run a visual report",
            "description": {
              "content": "Return reporting data aggregated by the requested granularity, split by the requested dimensions, narrowed by the requested filters, and containing the requested metrics.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "visual_reports.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "auth_token",
                  "value": "<string>",
                  "description": "(Required) The AUTH_TOKEN issued by /api/auth."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "Start date for the report. Defaults to seven days ago."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "End date for the report. Defaults to today."
                },
                {
                  "disabled": false,
                  "key": "granularity",
                  "value": "all",
                  "description": "Aggregation granularity for the report."
                },
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "EUR",
                  "description": "ISO 4217 currency code. All ISO 4217 currencies are supported."
                },
                {
                  "disabled": false,
                  "key": "time_zone",
                  "value": "<string>",
                  "description": "Rails TimeZone constant. Any timezone with a whole-hour offset to UTC is accepted; 30-minute offsets are not supported. Defaults to the user's default in the LiquidM platform."
                },
                {
                  "disabled": false,
                  "key": "dimensions",
                  "value": "<string>",
                  "description": "Comma-separated dimensions to split the result by."
                },
                {
                  "disabled": false,
                  "key": "filters",
                  "value": "<string>",
                  "description": "Comma-separated filters in <dimension>-<value> form. Every dimension is also available as a filter."
                },
                {
                  "disabled": false,
                  "key": "metrics",
                  "value": "ais,cost",
                  "description": "Comma-separated metrics to report."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "a3524dc3-61f9-454f-b50f-39209a7cf9c7",
              "name": "The report.",
