              "body": "{\n  \"columns\": [\n    {\n      \"id\": \"country\",\n      \"name\": \"Country\"\n    },\n    {\n      \"id\": \"ais\",\n      \"name\": \"AIs\"\n    },\n    {\n      \"id\": \"clicks\",\n      \"name\": \"Clicks\"\n    }\n  ],\n  \"dimensions\": [\n    \"country\"\n  ],\n  \"rows\": [\n    {\n      \"ais\": {\n        \"formatted_value\": \"81\",\n        \"value\": 81\n      },\n      \"clicks\": {\n        \"formatted_value\": \"1\",\n        \"value\": 1\n      },\n      \"country\": {\n        \"name\": \"COUNTRY1\",\n        \"value\": 98\n      }\n    }\n  ]\n}",
