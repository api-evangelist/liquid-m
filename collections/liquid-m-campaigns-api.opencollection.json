          "http": {
            "method": "POST",
            "url": "https://platform.liquidm.com/api/v1/campaigns",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "campaign",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Creates a campaign. The first-party client creates a budget first and passes the resulting budget id in budget_ids."
        }
      ]
    }
  ],
  "bundled": true
