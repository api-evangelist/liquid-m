      "type": "apikey",
      "key": "auth_token",
      "value": "{{auth_token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Budgets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
