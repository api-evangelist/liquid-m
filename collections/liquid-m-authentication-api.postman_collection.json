{
  "item": [
    {
      "id": "ff7192e2-ff32-4032-8ee6-3415c12f3693",
      "name": "Authentication",
      "description": {
        "content": "Auth token issuance for the Reporting API.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f42de52a-5c21-46a7-8d7d-6b4f4e1baa2e",
          "name": "Issue a Reporting API auth token",
          "request": {
            "name": "Issue a Reporting API auth token",
            "description": {
              "content": "Exchange LiquidM platform login credentials for an AUTH_TOKEN used on all subsequent Reporting API requests. Requesting a new token invalidates the previous one.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "auth"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "(Required) LiquidM platform login email."
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "<password>",
                  "description": "(Required) LiquidM platform login password."
                },
                {
                  "disabled": false,
                  "key": "api",
                  "value": "true",
                  "description": "(Required) Must be true to request an API token."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "d893c7a4-90d0-4a54-9f5c-eef40d288976",
              "name": "An auth token was issued.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "auth"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "email",
                      "value": "<email>"
                    },
                    {
                      "key": "password",
                      "value": "<password>"
                    },
                    {
                      "key": "api",
                      "value": "true"
                    },
                    {
                      "key": "auth_token",
                      "value": "<API Key>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
